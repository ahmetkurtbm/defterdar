# Boş bırakılırsa geliştirmede gömülü Postgres (PGlite) kullanılır: .data/pglite
# Üretimde Supabase/Neon bağlantısı. Sorgular `app_user` (kiracı verisi) ve `app_system`
# (giriş/oturum/portal) rollerine düşer; migration'lar bağlantı kullanıcısını bu rollere üye yapar.
DATABASE_URL=

# Portal linkleri bu sırdan türetilir; değişirse tüm linkler geçersiz olur. En az 32 karakter.
# Geliştirmede boşsa .data/secret dosyasına otomatik üretilir. Üretimde zorunlu.
DEFTERDAR_SECRET=

# Mükellefe giden linklerin kökü (ör. https://defterdar.app). Üretimde zorunlu; geliştirmede boşsa
# istek başlığından türetilir.
DEFTERDAR_PUBLIC_URL=

# Belge içeriğinden sınıflandırma (Anthropic API). Boşsa dosya adına göre tahmin edilir.
ANTHROPIC_API_KEY=
# DEFTERDAR_AI=0 ile içerikten sınıflandırma kapatılabilir.

# Belgelerin yerel klasörü (varsayılan .data/uploads)
DEFTERDAR_STORAGE_DIR=

# DEFTERDAR_DEMO=0 ile geliştirmede demo ofisi kurulmaz.
